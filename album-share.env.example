# Copy to album-share.env next to Immich's docker-compose.yml, then: chmod 600 album-share.env

# One API key per album OWNER (comma-separated). Only an album's owner can add users to it.
# Create in Immich: Account Settings -> API Keys -> New API Key, with permissions:
#   user.read, album.read, albumUser.create
IMMICH_API_KEYS=

# Accounts whose albums are ALL shared, no marker needed (comma-separated emails). Optional.
SHARE_ALL_OWNERS=

# Albums whose description starts with this get shared, for any owner with a key above.
SHARE_MARKER=[Shared]

# Role given to added users: editor or viewer
SHARE_ROLE=editor

# Users never added (comma-separated emails), e.g. service accounts. Optional.
EXCLUDE_USERS=

# Seconds between syncs
INTERVAL_SECONDS=600

# Immich server as seen from this container (service name in Immich's compose file)
IMMICH_URL=http://immich-server:2283

# true = log what would change, change nothing
DRY_RUN=false
